{
  "height": 30,
  "spacing": 4,
  "modules-left": [
    "hyprland/workspaces",
    "sway/mode",
    "sway/scratchpad",
    "mpris"
  ],
  "modules-center": [
    "custom/chrome",
    "custom/vscode",
    "custom/sep",
    "clock"
  ],
  "modules-right": [
    //"idle_inhibitor",
    "pulseaudio",
    "network",
    "power-profiles-daemon",
    //"cpu",
    //"memory",
    //"temperature",
    //"backlight",
    "keyboard-state",
    "battery",
    "battery#bat2",
    "tray",
    "custom/wlogout"
  ],
  "hyprland/workspaces": {
    "disable-scroll": false,
    "all-outputs": true,
    "format": "{name}"
  },
  "keyboard-state": {
    "numlock": true,
    "capslock": true,
    "format": "{name} {icon}",
    "format-icons": {
      "locked": "",
      "unlocked": ""
    }
  },
  "sway/mode": {
    "format": "<span style=\"italic\">{}</span>"
  },
  "sway/scratchpad": {
    "format": "{icon} {count}",
    "show-empty": false,
    "format-icons": ["", ""],
    "tooltip": true,
    "tooltip-format": "{app}: {title}"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    }
  },
  "tray": {
    "spacing": 10
  },
  "clock": {
    "interval": 60,
    "format": "{:%a %d %b  %I:%M %p}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format-alt": "{:%Y-%m-%d}"
  },
  "cpu": {
    "format": "{usage}% ",
    "tooltip": false
  },
  "memory": {
    "format": "{}% "
  },
  "temperature": {
    "critical-threshold": 80,
    "format": "{temperatureC}°C {icon}",
    "format-icons": ["", "", ""]
  },
  "backlight": {
    "format": "{percent}% {icon}",
    "format-icons": ["", "", "", "", "", "", "", "", ""]
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% 🔋",
    "format-full": "{capacity}% 🔋",
    "format-charging": "{capacity}% 🔋",
    "format-plugged": "{capacity}% 🔋"
    // No format-alt here: click must not swap the label to time remaining.
    // Tooltip stays at its default ({timeTo}), so hover still reports status.
  },
  "battery#bat2": {
    "bat": "BAT2",
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{capacity}% 🔋",
    "format-full": "{capacity}% 🔋",
    "format-charging": "{capacity}% 🔋",
    "format-plugged": "{capacity}% 🔋"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },
  "network": {
    "format-wifi": "{essid} ({signalStrength}%) ",
    "format-ethernet": "{ipaddr}/{cidr} ",
    "interval": 5,
    "tooltip-format": "{ifname}: {ipaddr} via {gwaddr}\n\u2193 {bandwidthDownBytes}  \u2191 {bandwidthUpBytes}",
    "format-linked": "{ifname} (No IP) ",
    "format-disconnected": "Disconnected ⚠",
    "on-click": "iwgtk"
  },
  "pulseaudio": {
    "format": "{volume}% {icon} {format_source}",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-bluetooth-muted": " {icon} {format_source}",
    "format-muted": " {format_source}",
    "format-source": "{volume}% ",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""]
    },
    "on-click": "pavucontrol"
  },
  "mpris": {
    "format": "{player_icon} {status_icon} {dynamic} ",
    "format-paused": "{player_icon} {status_icon} <i>{dynamic}</i> ",
    "dynamic-order": ["artist", "title", "position", "length"],
    "dynamic-len": 40,
    "player-icons": {
      "default": "🎜",
      "spotify": "",
      "firefox": "",
      "vlc": ""
    },
    "status-icons": {
      "playing": "",
      "paused": ""
    },
    "tooltip-format": "{player} ({status})\n{artist} - {title}\n{album}"
  },
  "custom/wlogout": {
    "format": "⏻",
    "tooltip": "Power Menu",
    "on-click": "wlogout"
  },
  "custom/chrome": {
    "format": "",
    "tooltip": "Google Chrome",
    "on-click": "google-chrome-stable",
    "on-click-right": "google-chrome-stable --incognito"
  },
  "custom/vscode": {
    "format": "",
    "tooltip": "Visual Studio Code",
    "on-click": "code"
  },
  "custom/sep": {
    "format": " ",
    "tooltip": false
  }
}

